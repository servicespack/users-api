    "@mikro-orm/mongodb": "^6.6.7",
    "@mikro-orm/reflection": "^6.6.7",
    "@mikro-orm/sqlite": "^6.6.7",
    "@node-rs/argon2": "^2.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
